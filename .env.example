# Copier ce fichier en .env (à la racine du projet) puis renseigner les valeurs.
# Ce fichier n'est lu que par le serveur Node : aucune variable n'est envoyée au navigateur.

# Clé API Groq (obligatoire pour que l'assistante réponde). https://console.groq.com/keys
GROQ_API_KEY=

# Modèle Groq utilisé (doit supporter l'appel d'outils / tool calling).
GROQ_MODEL=openai/gpt-oss-120b

# Port du serveur API.
PORT=8787

# Adaptateur de catalogue : "demo" (données locales de démonstration) ou "shared"
# (future base partagée avec la boutique, pas encore implémentée).
CATALOG_ADAPTER=demo

# Dossier où le serveur conserve ses données locales (démo, conversations, images).
DATA_DIR=./data
